[flake8]
max-line-length = 88
; E203 (whitespace before ':') and W503 (line break before binary operator)
; conflict with how black formats code -- disabling them is black's own
; documented recommendation: https://black.readthedocs.io/en/stable/guides/using_black_with_other_tools.html
extend-ignore = E203, W503
exclude = .git,__pycache__,.venv,venv,.mypy_cache
